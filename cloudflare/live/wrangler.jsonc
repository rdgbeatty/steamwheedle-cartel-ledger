{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "gathering-ledger",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {"directory":"./site","run_worker_first":["/api/*"]},
  "durable_objects": {"bindings":[{"name":"BOOKS","class_name":"BookDay"},{"name":"CONTROL","class_name":"LiveControl"},{"name":"COLLECTOR","class_name":"MarketCollector"}]},
  "migrations":[{"tag":"live-v1","new_sqlite_classes":["BookDay","LiveControl"]},{"tag":"collector-v1","new_sqlite_classes":["MarketCollector"]}],
  "kv_namespaces":[{"binding":"EXPIRY"},{"binding":"LATEST"}],
  "triggers": {"crons": ["37 * * * *"]},
  "observability":{"enabled":false}
}
