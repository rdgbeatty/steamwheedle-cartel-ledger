{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gathering-ledger-staging",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./site", "run_worker_first": ["/api/*"] },
  "durable_objects": {
    "bindings": [
      { "name": "CONTROL", "class_name": "MarketControl" },
      { "name": "HISTORY", "class_name": "HistoryShard" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MarketControl", "HistoryShard"] }
  ]
}
